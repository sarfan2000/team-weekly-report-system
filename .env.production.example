# PRODUCTION FRONTEND ENVIRONMENT VARIABLES
# For Vercel deployment

# Backend API URL (Update with your Railway backend URL)
VITE_API_URL=https://your-backend-url.railway.app/api

# ========================================
# DEPLOYMENT INSTRUCTIONS:
# ========================================
# 1. Deploy backend to Railway first
# 2. Get your Railway backend URL
# 3. Update VITE_API_URL above with that URL
# 4. Deploy frontend to Vercel
# 5. Add VITE_API_URL as environment variable in Vercel dashboard
# ========================================
