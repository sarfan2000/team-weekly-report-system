# PRODUCTION ENVIRONMENT VARIABLES
# Copy this file and update values for production deployment

# Server Configuration
NODE_ENV=production
PORT=5000

# MongoDB Atlas (Production Database)
# Format: mongodb+srv://username:password@cluster.mongodb.net/database-name?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://weekly-reports-user:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/weekly-reports?retryWrites=true&w=majority

# JWT Configuration (CHANGE THESE!)
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long-change-this-in-production
JWT_EXPIRES_IN=7d

# CORS Configuration (Update with your frontend URL)
CORS_ORIGIN=https://your-frontend-domain.vercel.app

# OpenAI Configuration (Optional - for AI Assistant)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ========================================
# IMPORTANT SECURITY NOTES:
# ========================================
# 1. NEVER commit this file with real values to Git
# 2. Use strong, random JWT_SECRET (min 32 characters)
# 3. Update MONGODB_URI with your Atlas connection string
# 4. Update CORS_ORIGIN with your actual frontend URL
# 5. Keep all sensitive values secret
# ========================================
